# Copy this file to .env, then paste values from Supabase Dashboard > Connect.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Never put this value in HTML, JavaScript, Git, or a frontend host.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# For local development. Change to your HTTPS production address when deployed.
APP_BASE_URL=http://127.0.0.1:5000
# Generate a random value, for example: python -c "import secrets; print(secrets.token_urlsafe(32))"
AURA_SECRET_KEY=replace-with-a-long-random-value
